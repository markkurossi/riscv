{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "append":  "earlycon=sbi console=ttyS0,115200 root=/dev/vda1 ro rootwait systemd.mask=systemd-networkd-wait-online.service",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "ubuntu-24.04/ubuntu-24.04.4-preinstalled-server-riscv64.img"
    }
  ],
  "netdevs": [
    {
      "id":         "eth0",
      "ip":         "192.168.42.2",
      "gw":         "192.168.42.254",
      "hostname":   "ubuntu",
      "domainname": "goemu.markkurossi.com"
    }
  ],
  "gpus": [
    {
      "id":     "gpu",
      "width":  1024,
      "height": 768
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    },
    {
      "type": "virtio-gpu-device",
      "gpu":  "gpu"
    }
  ]
}
