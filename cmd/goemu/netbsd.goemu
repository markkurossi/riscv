{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "append":  "console=com0 root=sd0a",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "netbsd/riscv64.img"
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    }
  ]
}
