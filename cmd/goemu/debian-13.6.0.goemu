{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "append":  "earlycon=sbi console=ttyS0,115200",
  "memory":  "2G",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "debian-13.6.0/debian-13.6.0-riscv64-DVD-1.iso"
    },
    {
      "id":     "hd1",
      "format": "raw",
      "file":   "debian-13.6.0/debian-riscv64.img"
    }
  ],
  "netdevs": [
    {
      "id":         "eth0",
      "ip":         "192.168.42.5",
      "gw":         "192.168.42.254",
      "hostname":   "debian",
      "domainname": "goemu.ephemelier.com"
    }
  ],
  "gpus": [
    {
      "id":     "gpu",
      "title":  "Debian 13.6.0",
      "width":  1024,
      "height": 768,
      "pointer": "touchpad"
    }
  ],
  "_devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    },
    {
      "type":  "virtio-blk-device",
      "drive": "hd1"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    },
    {
      "type": "virtio-gpu-device",
      "gpu":  "gpu"
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd1"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    },
    {
      "type": "virtio-gpu-device",
      "gpu":  "gpu"
    }
  ]
}
