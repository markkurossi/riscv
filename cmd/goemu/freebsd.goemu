{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "_append":  "console=ttyS0,115200",
  "append":  "-v",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "freebsd/FreeBSD-15.1-RELEASE-riscv-riscv64-GENERICSD.img"
    }
  ],
  "netdevs": [
    {
      "id": "eth0",
      "ip": "192.168.42.1",
      "gw": "192.168.42.254"
    }
  ],
  "_devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    }
  ]
}
