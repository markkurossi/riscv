{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "append":  "-v",
  "memory":  "2G",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "freebsd/FreeBSD-15.1-RELEASE-riscv-riscv64-GENERICSD.img"
    }
  ],
  "netdevs": [
    {
      "id":         "eth0",
      "ip":         "192.168.42.1",
      "gw":         "192.168.42.254",
      "hostname":   "freebsd",
      "domainname": "goemu.ephemelier.com"
    }
  ],
  "gpus": [
    {
      "id":     "gpu",
      "title":  "FreeBSD 15.1",
      "width":  1024,
      "height": 768
    }
  ],
  "_devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    },
    {
      "type": "virtio-gpu-device",
      "gpu":  "gpu"
    }
  ]
}
