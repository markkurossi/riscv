{
  "bios":    "opensbi/fw_jump.bin",
  "kernel":  "u-boot-2026.04/u-boot.bin",
  "append":  "-v",
  "drives": [
    {
      "id":     "hd0",
      "format": "raw",
      "file":   "openbsd/install79.img"
    },
    {
      "id":     "hd1",
      "format": "raw",
      "file":   "openbsd/disk.img"
    }
  ],
  "netdevs": [
    {
      "id":         "eth0",
      "ip":         "192.168.42.4",
      "gw":         "192.168.42.254",
      "hostname":   "openbsd",
      "domainname": "goemu.ephemelier.com"
    }
  ],
  "devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd1"
    },
    {
      "type":   "virtio-net-device",
      "netdev": "eth0"
    }
  ],
  "_devices": [
    {
      "type":  "virtio-blk-device",
      "drive": "hd0"
    }
  ]
}
